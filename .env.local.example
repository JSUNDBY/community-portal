# Sandstone Ridge Portal — environment template.
# Copy this file to .env.local for development, set the same vars in Vercel
# for production. Never commit .env.local.

# ============================================================================
# Supabase (per-community project)
# ============================================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only. Bypasses RLS. Never ship to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================================
# Branding (per community — these are the only swap-points between deploys)
# ============================================================================
NEXT_PUBLIC_COMMUNITY_NAME="Sandstone Ridge HOA"
NEXT_PUBLIC_COMMUNITY_SLUG="sandstone-ridge"
NEXT_PUBLIC_COMMUNITY_DOMAIN="portal.sandstoneridge.com"
NEXT_PUBLIC_PRIMARY_COLOR="#0B1F3B"
NEXT_PUBLIC_ACCENT_COLOR="#3B82F6"
COMMUNITY_CONTACT_EMAIL="board@sandstoneridge.com"

# ============================================================================
# Email (Resend) — leave RESEND_API_KEY blank in dev to queue without sending.
# ============================================================================
RESEND_API_KEY=
EMAIL_FROM="Sandstone Ridge <noreply@sandstoneridge.com>"

# ============================================================================
# SMS (Twilio) — leave creds blank in dev to queue without sending.
# ============================================================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
